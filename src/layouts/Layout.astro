---
import '../styles/global.scss';

interface Props {
	title?: string;
	description?: string;
}

	const { 
		title = "Anthony Calonaci | Wall & Floor Tiler Melbourne — Expert Tiling Services",
		description = "Melbourne's trusted wall and floor tiler. Specialising in ceramic, porcelain, marble and natural stone installation for bathrooms, kitchens, patios and commercial spaces. Waterproofing, grouting, tile repairs and sealing across Melbourne."
	} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" style="scroll-padding-top: 5rem">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />

		<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous"/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/images/logo.png', Astro.url)} />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:site_name" content="Anthony Calonaci Tiling" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/images/logo.png', Astro.url)} />
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "Anthony Calonaci",
			"image": "https://asktony.com.au/images/portfolio/anthony.webp",
			"url": "https://asktony.com.au",
			"telephone": "+61451644016",
			"email": "tony@asktony.com.au",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Melbourne",
				"addressRegion": "VIC",
				"addressCountry": "AU"
			},
			"priceRange": "$$",
			"description": "Melbourne wall and floor tiler specialising in ceramic, porcelain, marble and natural stone installation.",
			"areaServed": {
				"@type": "City",
				"name": "Melbourne"
			},
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": "Tiling Services",
				"itemListElement": [
					{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tile & Stone Installation" } },
					{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bathroom Renovations" } },
					{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Splashbacks" } },
					{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Waterproofing" } },
					{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Grouting & Sealing" } },
					{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tile Repairs" } }
				]
			}
		}
	</script>
	</head>
	<body class="selection:bg-brand-accent selection:text-white overflow-x-hidden">
		<slot />
	</body>
</html>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('revealed');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.1 });

	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.reveal-up').forEach((el) => {
			const rect = el.getBoundingClientRect();
			if (rect.top < window.innerHeight && rect.bottom > 0) {
				el.classList.add('revealed');
			} else {
				observer.observe(el);
			}
		});
	});
</script>
