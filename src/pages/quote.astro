---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Free Tiling Quote Melbourne | Anthony Calonaci — Wall & Floor Tiler"
  description="Get a free tiling quote from Anthony Calonaci, your trusted wall and floor tiler in Melbourne. Send a video enquiry through Tradsiee for fast, accurate pricing — no site visit needed."
>
  <Navbar />
  <main>
    <!-- Header + Form -->
    <section class="pt-28 lg:pt-32 pb-24 lg:pb-28 bg-brand-surface">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="text-center">
          <h1 class="heading-lg">Get a Free Tiling Quote.</h1>
          <p class="text-readable mt-6 max-w-2xl mx-auto">
            Send a video enquiry through Tradsiee and receive a free, obligation-free tiling quote for your Melbourne project. We assess your project remotely before setting foot on site — saving you time and providing accurate pricing.
          </p>
        </div>

        <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-start mt-16">
          <!-- Tradsiee Widget -->
          <div class="lg:col-span-7 justify-self-center self-start">
            <div class="glass-card !px-6 lg:!px-8 !pb-6 lg:!pb-8 !pt-10 w-fit min-w-[300px] max-h-[650px] h-fit">
              <div class="text-center space-y-1 mb-4 px-4">
                <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Send your tiling video enquiry</span>
                <p class="text-sm text-brand-dim">Record your Melbourne tiling project directly in your browser. No account or download needed.</p>
              </div>
              <div id="tradsiee-widget-root" class="flex justify-center px-4"></div><script src="https://tradsiee.com/loader.js?slug=admin-5003" async></script>
            </div>
          </div>

          <!-- Steps -->
          <div class="lg:col-span-5">
            <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">How it works</span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-brand-muted mt-4 mb-10">
              Three steps to your tiling quote.
            </h2>

            <div class="space-y-10">
              <div class="flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-video text-brand-accent text-sm"></i>
                  </div>
                  <div class="w-px flex-1 bg-white/[0.08] mt-3"></div>
                </div>
                <div class="pb-2">
                    <p class="text-lg font-bold text-brand-muted">Record your tiling space</p>
                    <p class="text-base text-brand-dim leading-relaxed mt-2">
                      Record your tiling area on your phone, showing walls, floors and the full space. We will review the footage to understand exactly what your Melbourne project requires.
                    </p>
                </div>
              </div>

              <div class="flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-file-invoice text-brand-accent text-sm"></i>
                  </div>
                  <div class="w-px flex-1 bg-white/[0.08] mt-3"></div>
                </div>
                <div class="pb-2">
                    <p class="text-lg font-bold text-brand-muted">We assess &amp; quote</p>
                    <p class="text-base text-brand-dim leading-relaxed mt-2">
                      We review the video, calculate materials and labour, and send a comprehensive tiling quote. Faster and more convenient than a traditional site visit.
                    </p>
                </div>
              </div>

              <div class="flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-check-circle text-brand-accent text-sm"></i>
                  </div>
                </div>
                <div>
                    <p class="text-lg font-bold text-brand-muted">Book your tiling installation</p>
                    <p class="text-base text-brand-dim leading-relaxed mt-2">
                      Approve your tiling quote and we arrive prepared for your Melbourne project. One team, one visit, completed to the highest standard.
                    </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="py-20 lg:py-24 bg-brand-base">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="text-center mb-12">
          <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Still have questions about your tiling project?</span>
          <h2 class="heading-lg mt-4">Get in Touch for Your Tiling Quote.</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          <div class="glass-card !p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center mx-auto mb-5">
              <i class="fas fa-envelope text-brand-accent text-lg"></i>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-2">Email Us</p>
            <a href="mailto:tony@asktony.com.au" class="text-lg font-bold text-brand-muted hover:text-brand-accent transition-colors">
              tony@asktony.com.au
            </a>
          </div>

          <div class="glass-card !p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center mx-auto mb-5">
              <i class="fas fa-phone text-brand-accent text-lg"></i>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-2">Call Us</p>
            <a href="tel:+61451644016" class="text-lg font-bold text-brand-muted hover:text-brand-accent transition-colors">
              +61 451 644 016
            </a>
          </div>

          <div class="glass-card !p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center mx-auto mb-5">
              <i class="fas fa-map-marker-alt text-brand-accent text-lg"></i>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-2">Location</p>
            <p class="text-lg font-bold text-brand-muted">Melbourne, VIC</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
