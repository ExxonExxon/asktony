---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Get a Quote | Anthony Calocani — Wall & Floor Tiling Melbourne" description="Send a video enquiry through Tradsiee for a free quote. No site visit needed.">
	<Navbar />
	<main class="pt-20">
		<section class="section-padding bg-brand-surface">
			<div class="max-w-7xl mx-auto px-6 lg:px-20">
				<div class="grid lg:grid-cols-2 gap-20">
					<!-- Quote Info -->
					<div class="space-y-12 reveal-up">
						<div class="space-y-6">
							<h1 class="heading-lg">Get a Quote.</h1>
							<p class="text-readable max-w-md">
								Send a video enquiry through Tradsiee and get a free quote. We review the job before we step on site.
							</p>
						</div>

						<div class="space-y-6">
							<h3 class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">How it works</h3>
							<div class="space-y-8">
								<div class="flex items-start space-x-5">
									<span class="text-2xl font-bold text-brand-dim w-8 flex-shrink-0">01</span>
									<div class="space-y-2">
										<p class="text-xl font-bold text-brand-muted uppercase tracking-tight">Record your space</p>
										<p class="text-base text-brand-dim leading-relaxed">Use your phone to show the area. Walls, floors, the whole space. We'll see exactly what needs doing.</p>
									</div>
								</div>
								<div class="flex items-start space-x-5">
									<span class="text-2xl font-bold text-brand-dim w-8 flex-shrink-0">02</span>
									<div class="space-y-2">
										<p class="text-xl font-bold text-brand-muted uppercase tracking-tight">We assess &amp; quote</p>
										<p class="text-base text-brand-dim leading-relaxed">We review the video, calculate the materials and send a detailed quote. Faster than a site visit.</p>
									</div>
								</div>
								<div class="flex items-start space-x-5">
									<span class="text-2xl font-bold text-brand-dim w-8 flex-shrink-0">03</span>
									<div class="space-y-2">
										<p class="text-xl font-bold text-brand-muted uppercase tracking-tight">Book installation</p>
										<p class="text-base text-brand-dim leading-relaxed">Approve the quote and we come ready. One team, one visit, done right.</p>
									</div>
								</div>
							</div>
						</div>

						<div class="space-y-6 pt-4">
							<h3 class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Still have questions?</h3>
							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center flex-shrink-0 backdrop-blur-xl">
									<i class="fas fa-envelope text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-1">Email Us</p>
									<a href="mailto:tony@asktony.com.au" class="text-xl font-bold text-brand-muted hover:text-brand-accent transition-colors">tony@asktony.com.au</a>
								</div>
							</div>

							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center flex-shrink-0 backdrop-blur-xl">
									<i class="fas fa-phone text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-1">Call Us</p>
									<a href="tel:+61451644016" class="text-xl font-bold text-brand-muted hover:text-brand-accent transition-colors">+61 451 644 016</a>
								</div>
							</div>

							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center flex-shrink-0 backdrop-blur-xl">
									<i class="fas fa-map-marker-alt text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-1">Location</p>
									<p class="text-xl font-bold text-brand-muted">Melbourne, VIC</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Tradsiee Widget -->
					<div class="reveal-up text-center" style="animation-delay: 0.2s;">
						<div class="space-y-4 mb-8">
							<h3 class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Send your video enquiry</h3>
							<p class="text-base text-brand-dim leading-relaxed">Record directly in your browser. No account needed.</p>
						</div>
						<div id="tradsiee-widget-root" class="glass-card !p-6 inline-block"></div>
						<script src="https://tradsiee.com/loader.js?slug=admin-5003" async></script>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
