---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Get a Free Quote | Anthony Calocani — Wall & Floor Tiling Melbourne"
  description="Request a free, obligation-free quote for your wall and floor tiling project in Melbourne. Send a video enquiry through Tradsiee — fast, accurate, no site visit needed."
>
  <Navbar />
  <main class="pt-20">
    <!-- Header -->
    <section class="section-padding bg-brand-base">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="max-w-3xl reveal-up">
          <h1 class="heading-lg">Get a Quote.</h1>
          <p class="text-readable mt-6 max-w-2xl">
            Send a video enquiry through Tradsiee and receive a free, obligation-free quote. We assess your project remotely before setting foot on site — saving you time and providing accurate pricing.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content: Widget + Steps -->
    <section class="section-padding bg-brand-surface">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-start">
          <!-- Tradsiee Widget -->
          <div class="lg:col-span-7 reveal-up">
            <div class="glass-card !p-8 lg:!p-12">
              <div class="space-y-4 mb-8 text-center lg:text-left">
                <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Send your video enquiry</span>
                <p class="text-brand-dim leading-relaxed">Record directly in your browser. No account or download needed.</p>
              </div>
              <div id="tradsiee-widget-root"></div><script src="https://tradsiee.com/loader.js?slug=admin-5003" async></script>
            </div>
          </div>

          <!-- Steps -->
          <div class="lg:col-span-5 reveal-up" style="animation-delay: 0.15s;">
            <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">How it works</span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-brand-muted mt-4 mb-10">
              Three simple steps.
            </h2>

            <div class="space-y-10">
              <div class="flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-video text-brand-accent text-sm"></i>
                  </div>
                  <div class="w-px flex-1 bg-white/[0.08] mt-3"></div>
                </div>
                <div class="pb-2">
                  <p class="text-lg font-bold text-brand-muted">Record your space</p>
                  <p class="text-base text-brand-dim leading-relaxed mt-2">
                    Record the area on your phone, showing walls, floors and the full space. We will review the footage to understand exactly what your project requires.
                  </p>
                </div>
              </div>

              <div class="flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-file-invoice text-brand-accent text-sm"></i>
                  </div>
                  <div class="w-px flex-1 bg-white/[0.08] mt-3"></div>
                </div>
                <div class="pb-2">
                  <p class="text-lg font-bold text-brand-muted">We assess &amp; quote</p>
                  <p class="text-base text-brand-dim leading-relaxed mt-2">
                    We review the video, calculate materials and labour, and send a comprehensive quote. Faster and more convenient than a traditional site visit.
                  </p>
                </div>
              </div>

              <div class="flex gap-5">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-check-circle text-brand-accent text-sm"></i>
                  </div>
                </div>
                <div>
                  <p class="text-lg font-bold text-brand-muted">Book installation</p>
                  <p class="text-base text-brand-dim leading-relaxed mt-2">
                    Approve the quote and we arrive prepared. One team, one visit, completed to the highest standard.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section-padding bg-brand-base">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="text-center mb-16 reveal-up">
          <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Still have questions?</span>
          <h2 class="heading-lg mt-4">Get in touch.</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto reveal-up">
          <div class="glass-card !p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center mx-auto mb-5">
              <i class="fas fa-envelope text-brand-accent text-lg"></i>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-2">Email Us</p>
            <a href="mailto:tony@asktony.com.au" class="text-lg font-bold text-brand-muted hover:text-brand-accent transition-colors">
              tony@asktony.com.au
            </a>
          </div>

          <div class="glass-card !p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center mx-auto mb-5">
              <i class="fas fa-phone text-brand-accent text-lg"></i>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-2">Call Us</p>
            <a href="tel:+61451644016" class="text-lg font-bold text-brand-muted hover:text-brand-accent transition-colors">
              +61 451 644 016
            </a>
          </div>

          <div class="glass-card !p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center mx-auto mb-5">
              <i class="fas fa-map-marker-alt text-brand-accent text-lg"></i>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-brand-dim mb-2">Location</p>
            <p class="text-lg font-bold text-brand-muted">Melbourne, VIC</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
