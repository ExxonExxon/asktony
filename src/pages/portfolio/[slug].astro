---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projects, getProjectBySlug } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { name, category, description, images } = project;
---

<Layout
  title={`${name} | Anthony Calocani — Portfolio`}
  description={`${name} — ${category?.toLowerCase()} tiling project by Anthony Calocani in Melbourne.`}
>
  <Navbar />
  <main class="pt-20">
    <section class="section-padding pb-0 lg:pb-0">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <a
          href="/#portfolio"
          class="inline-flex items-center gap-1.5 text-sm text-brand-dim hover:text-brand-accent transition-colors mb-8"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Go back
        </a>
        <div class="mb-12 reveal-up">
          <h1 class="heading-lg">{name}</h1>
          {description && <p class="text-readable mt-4 max-w-2xl">{description}</p>}
        </div>
      </div>
    </section>

    <section class="pb-32 lg:pb-48">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        {images.length > 0 ? (
          <div class="masonry-gallery reveal-up">
            {images.map((src, i) => (
              <div class="masonry-item">
                <img src={src} alt={`${name} — photo ${i + 1}`} loading={i > 5 ? "lazy" : "eager"} />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-32">
            <p class="text-brand-dim text-lg font-medium">No photos added yet</p>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .masonry-gallery {
    column-count: 3;
    column-gap: 0.75rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    line-height: 0;
    position: relative;
    cursor: pointer;
  }

  .masonry-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    border-radius: 0.75rem;
    transition: background 0.25s;
    pointer-events: none;
  }

  .masonry-item:hover::after {
    background: rgba(0, 0, 0, 0.25);
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.75rem;
  }

  @media (max-width: 767px) {
    .masonry-gallery {
      column-count: 2;
    }
  }

  @media (max-width: 479px) {
    .masonry-gallery {
      column-count: 1;
    }
  }
</style>

<style is:global>
  .photo-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
  }

  .photo-modal-wrapper {
    position: relative;
    max-width: 95vw;
    max-height: 95vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .photo-modal-wrapper.zoom-active {
    overflow: auto;
    display: block;
  }

  .photo-modal-img {
    display: block;
    max-width: 95vw;
    max-height: 95vh;
    width: auto;
    height: auto;
    flex-shrink: 0;
    cursor: zoom-in;
  }

  .photo-modal-close {
    position: fixed;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
    z-index: 1;
  }

  .photo-modal-close:hover {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    if (/iPhone/.test(navigator.userAgent)) return;

    const item = e.target.closest('.masonry-item img');
    if (!item) return;

    const src = item.getAttribute('src');
    const alt = item.getAttribute('alt') || '';
    const nw = item.naturalWidth;
    const nh = item.naturalHeight;

    const overlay = document.createElement('div');
    overlay.className = 'photo-modal';
    overlay.innerHTML = `
      <div class="photo-modal-backdrop"></div>
      <div class="photo-modal-wrapper">
        <img src="${src}" alt="${alt}" class="photo-modal-img" />
        <button class="photo-modal-close" aria-label="Close">&times;</button>
      </div>
    `;

    const close = () => overlay.remove();
    overlay.querySelector('.photo-modal-backdrop').addEventListener('click', close);
    overlay.querySelector('.photo-modal-close').addEventListener('click', (e) => {
      e.stopPropagation();
      close();
    });

    const img = overlay.querySelector('.photo-modal-img');
    const wrapper = overlay.querySelector('.photo-modal-wrapper');
    const ZOOMS = [0, 2, 3];
    let zoomIdx = 0;

    img.addEventListener('click', (e) => {
      e.stopPropagation();
      zoomIdx = (zoomIdx + 1) % ZOOMS.length;
      const scale = ZOOMS[zoomIdx];

      if (scale === 0) {
        img.style.maxWidth = '95vw';
        img.style.maxHeight = '95vh';
        img.style.width = 'auto';
        img.style.height = 'auto';
        img.style.cursor = 'zoom-in';
        wrapper.classList.remove('zoom-active');
      } else {
        img.style.maxWidth = 'none';
        img.style.maxHeight = 'none';
        img.style.width = (nw * scale) + 'px';
        img.style.height = (nh * scale) + 'px';
        img.style.cursor = 'pointer';
        wrapper.classList.add('zoom-active');
      }
    });

    document.body.appendChild(overlay);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const overlay = document.querySelector('.photo-modal');
      if (overlay) overlay.remove();
    }
  });
</script>
