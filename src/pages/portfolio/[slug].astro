---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projects, getProjectBySlug } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { name, category, images } = project;
---

<Layout
  title={`${name} | Anthony Calocani — Portfolio`}
  description={`${name} — ${category?.toLowerCase()} tiling project by Anthony Calocani in Melbourne.`}
>
  <Navbar />
  <main class="pt-20">
    <section class="section-padding pb-0 lg:pb-0">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <a
          href="/#portfolio"
          class="inline-flex items-center gap-2 text-xs font-bold text-brand-accent uppercase tracking-wider hover:text-brand-accent-bright transition-colors mb-8"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back to Portfolio
        </a>
        <div class="mb-12 reveal-up">
          <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">{category}</span>
          <h1 class="heading-lg mt-2">{name}</h1>
        </div>
      </div>
    </section>

    <section class="pb-32 lg:pb-48">
      <div class="max-w-7xl mx-auto px-6 lg:px-20">
        {images.length > 0 ? (
          <div class="masonry-gallery reveal-up">
            {images.map((src, i) => (
              <div class="masonry-item">
                <img src={src} alt={`${name} — photo ${i + 1}`} loading={i > 5 ? "lazy" : "eager"} />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-32">
            <p class="text-brand-dim text-lg font-medium">No photos added yet</p>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .masonry-gallery {
    column-count: 3;
    column-gap: 1rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    border-radius: 1rem;
    overflow: hidden;
    background: #f3f4f6;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 1023px) {
    .masonry-gallery {
      column-count: 2;
    }
  }

  @media (max-width: 639px) {
    .masonry-gallery {
      column-count: 1;
    }
  }
</style>

<style is:global>
  .photo-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
  }

  .photo-modal-wrapper {
    position: relative;
    max-width: 95vw;
    max-height: 95vh;
    overflow: auto;
  }

  .photo-modal-img {
    display: block;
    max-width: none;
    width: auto;
    height: auto;
  }

  .photo-modal-close {
    position: fixed;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
    z-index: 1;
  }

  .photo-modal-close:hover {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    if (/iPhone/.test(navigator.userAgent)) return;

    const item = e.target.closest('.masonry-item img');
    if (!item) return;

    const src = item.getAttribute('src');
    const alt = item.getAttribute('alt') || '';

    const overlay = document.createElement('div');
    overlay.className = 'photo-modal';
    overlay.innerHTML = `
      <div class="photo-modal-backdrop"></div>
      <div class="photo-modal-wrapper">
        <img src="${src}" alt="${alt}" class="photo-modal-img" />
        <button class="photo-modal-close" aria-label="Close">&times;</button>
      </div>
    `;

    const close = () => overlay.remove();
    overlay.querySelector('.photo-modal-backdrop').addEventListener('click', close);
    overlay.querySelector('.photo-modal-close').addEventListener('click', close);

    document.body.appendChild(overlay);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const overlay = document.querySelector('.photo-modal');
      if (overlay) overlay.remove();
    }
  });
</script>
