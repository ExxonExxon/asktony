---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us | Ask Tony" description="Get in touch with Tony for expert wall and floor tiling services in Melbourne.">
	<Navbar />
	<main class="pt-32">
		<section class="section-padding">
			<div class="max-w-7xl mx-auto px-6 lg:px-20">
				<div class="grid lg:grid-cols-2 gap-20">
					<!-- Contact Info -->
					<div class="space-y-12 reveal-up">
						<div class="space-y-6">
							<span class="text-[10px] font-bold uppercase tracking-[0.4em] text-brand-accent">Get in Touch</span>
							<h1 class="heading-lg">Let's discuss your project.</h1>
							<p class="text-readable max-w-md">
								Whether you're looking for a full bathroom renovation or a simple kitchen splashback, we're here to help. Send us a message and we'll get back to you as soon as possible.
							</p>
						</div>

						<div class="space-y-8 pt-6">
							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-brand-surface flex items-center justify-center flex-shrink-0">
									<i class="fas fa-phone-alt text-brand-accent"></i>
								</div>
								<div>
									<p class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-1">Call Us</p>
									<p class="text-xl font-bold text-brand-dark">00 0000 0000</p>
								</div>
							</div>
							
							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-brand-surface flex items-center justify-center flex-shrink-0">
									<i class="fas fa-envelope text-brand-accent"></i>
								</div>
								<div>
									<p class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-1">Email Us</p>
									<p class="text-xl font-bold text-brand-dark">tony@asktony.com.au</p>
								</div>
							</div>

							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-brand-surface flex items-center justify-center flex-shrink-0">
									<i class="fas fa-map-marker-alt text-brand-accent"></i>
								</div>
								<div>
									<p class="text-[10px] font-bold uppercase tracking-widest text-brand-muted mb-1">Location</p>
									<p class="text-xl font-bold text-brand-dark">Melbourne, VIC</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Contact Form -->
					<div class="reveal-up" style="animation-delay: 0.2s;">
						<div class="glass-card p-8 md:p-12 radius-lg">
							<form action="#" method="POST" class="space-y-6">
								<div class="grid md:grid-cols-2 gap-6">
									<div class="space-y-2">
										<label for="name" class="text-[10px] font-bold uppercase tracking-widest text-brand-muted ml-1">Full Name</label>
										<input 
											type="text" 
											id="name" 
											name="name" 
											required 
											class="w-full px-6 py-4 bg-brand-surface border-none radius-md focus:ring-2 focus:ring-brand-accent transition-all outline-none text-brand-dark font-medium"
											placeholder="John Doe"
										/>
									</div>
									<div class="space-y-2">
										<label for="email" class="text-[10px] font-bold uppercase tracking-widest text-brand-muted ml-1">Email Address</label>
										<input 
											type="email" 
											id="email" 
											name="email" 
											required 
											class="w-full px-6 py-4 bg-brand-surface border-none radius-md focus:ring-2 focus:ring-brand-accent transition-all outline-none text-brand-dark font-medium"
											placeholder="john@example.com"
										/>
									</div>
								</div>
								<div class="space-y-2">
									<label for="phone" class="text-[10px] font-bold uppercase tracking-widest text-brand-muted ml-1">Phone Number</label>
									<input 
										type="tel" 
										id="phone" 
										name="phone" 
										class="w-full px-6 py-4 bg-brand-surface border-none radius-md focus:ring-2 focus:ring-brand-accent transition-all outline-none text-brand-dark font-medium"
										placeholder="0400 000 000"
									/>
								</div>
								<div class="space-y-2">
									<label for="message" class="text-[10px] font-bold uppercase tracking-widest text-brand-muted ml-1">Your Message</label>
									<textarea 
										id="message" 
										name="message" 
										rows="5" 
										required 
										class="w-full px-6 py-4 bg-brand-surface border-none radius-md focus:ring-2 focus:ring-brand-accent transition-all outline-none text-brand-dark font-medium resize-none"
										placeholder="Tell us about your project..."
									></textarea>
								</div>
								<button type="submit" class="btn-primary w-full !py-6">
									Send Message
								</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* Any specific styles for the contact page can go here */
</style>
