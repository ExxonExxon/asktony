---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Anthony Calocani — Wall & Floor Tiling Melbourne" description="Request a quote from Melbourne's trusted wall and floor tiling contractor. Specialising in bathroom renovations, kitchen splashbacks, waterproofing and tile installation for residential and commercial projects.">
	<Navbar />
	<main class="pt-0">
		<section class="section-padding bg-gray-50">
			<div class="max-w-7xl mx-auto px-6 lg:px-20">
				<div class="grid lg:grid-cols-2 gap-20">
					<!-- Contact Info -->
					<div class="space-y-12 reveal-up">
						<div class="space-y-6">
							<h1 class="heading-lg">Contact.</h1>
							<p class="text-readable max-w-md">
								From complete bathroom renovations and kitchen splashbacks to outdoor patios and commercial fit-outs — every project starts with a conversation. Send us the details or record a short video of the area and we'll be in touch with a comprehensive quote.
							</p>
						</div>

						<div class="space-y-8 pt-6">
							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white border border-gray-200 flex items-center justify-center flex-shrink-0">
									<i class="fas fa-phone-alt text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Call Us</p>
									<p class="text-xl font-bold text-gray-900">00 0000 0000</p>
								</div>
							</div>
							
							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white border border-gray-200 flex items-center justify-center flex-shrink-0">
									<i class="fas fa-envelope text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Email Us</p>
									<p class="text-xl font-bold text-gray-900">tony@asktony.com.au</p>
								</div>
							</div>

							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white border border-gray-200 flex items-center justify-center flex-shrink-0">
									<i class="fas fa-map-marker-alt text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Location</p>
									<p class="text-xl font-bold text-gray-900">Melbourne, VIC</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Contact Form -->
					<div class="reveal-up" style="animation-delay: 0.2s;">
						<div class="bg-white border border-gray-200 shadow-soft p-8 md:p-12 radius-lg">
							<form action="#" method="POST" class="space-y-6">
								<div class="grid md:grid-cols-2 gap-6">
									<div class="space-y-2">
										<label for="name" class="text-xs font-bold uppercase tracking-wider text-gray-500 ml-1">Full Name</label>
									<input 
											type="text" 
											id="name" 
											name="name" 
											required 
											class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-1 focus:ring-brand-accent/30 transition-all outline-none text-gray-900 font-medium placeholder:text-gray-400"
											placeholder="John Doe"
										/>
									</div>
									<div class="space-y-2">
										<label for="email" class="text-xs font-bold uppercase tracking-wider text-gray-500 ml-1">Email Address</label>
										<input 
											type="email" 
											id="email" 
											name="email" 
											required 
											class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-1 focus:ring-brand-accent/30 transition-all outline-none text-gray-900 font-medium placeholder:text-gray-400"
											placeholder="john@example.com"
										/>
									</div>
								</div>
								<div class="space-y-2">
										<label for="phone" class="text-xs font-bold uppercase tracking-wider text-gray-500 ml-1">Phone Number</label>
									<input 
										type="tel" 
										id="phone" 
										name="phone" 
										class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-1 focus:ring-brand-accent/30 transition-all outline-none text-gray-900 font-medium placeholder:text-gray-400"
										placeholder="0400 000 000"
									/>
								</div>
								<div class="space-y-2">
										<label for="message" class="text-xs font-bold uppercase tracking-wider text-gray-500 ml-1">Your Message</label>
									<textarea 
										id="message" 
										name="message" 
										rows="5" 
										required 
										class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:border-brand-accent focus:ring-1 focus:ring-brand-accent/30 transition-all outline-none text-gray-900 font-medium placeholder:text-gray-400 resize-none"
										placeholder="Tell us about your project..."
									></textarea>
								</div>
								<button type="submit" class="btn-primary w-full !py-6">
									Send Message
								</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* Any specific styles for the contact page can go here */
</style>
