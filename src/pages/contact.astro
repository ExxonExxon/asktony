---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Anthony Calocani — Wall & Floor Tiling Melbourne" description="Request a quote from Melbourne's trusted wall and floor tiling contractor. Specialising in bathroom renovations, kitchen splashbacks, waterproofing and tile installation for residential and commercial projects.">
	<Navbar />
	<main class="pt-20">
		<section class="section-padding bg-gray-50">
			<div class="max-w-7xl mx-auto px-6 lg:px-20">
				<div class="grid lg:grid-cols-2 gap-20">
					<!-- Contact Info -->
					<div class="space-y-12 reveal-up">
						<div class="space-y-6">
							<h1 class="heading-lg">Contact.</h1>
							<p class="text-readable max-w-md">
								Every project starts here. Send a Tradsiee video enquiry and we'll get back to you with a detailed quote.
							</p>
						</div>

						<div class="space-y-8 pt-6">
							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white border border-gray-200 flex items-center justify-center flex-shrink-0">
									<i class="fas fa-envelope text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Email Us</p>
									<p class="text-xl font-bold text-gray-900">tony@asktony.com.au</p>
								</div>
							</div>

							<div class="flex items-start space-x-6">
								<div class="w-12 h-12 rounded-full bg-white border border-gray-200 flex items-center justify-center flex-shrink-0">
									<i class="fas fa-map-marker-alt text-brand-accent"></i>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Location</p>
									<p class="text-xl font-bold text-gray-900">Melbourne, VIC</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Tradsiee Widget -->
					<div class="reveal-up" style="animation-delay: 0.2s;">
						<div id="tradsiee-widget-root"></div>
						<script src="https://tradsiee.com/loader.js?slug=admin-5003" async></script>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* Any specific styles for the contact page can go here */
</style>
