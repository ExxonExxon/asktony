---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Portfolio from '../components/Portfolio.astro';
import FAQ from '../components/FAQ.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Wall & Floor Tiler Melbourne | Anthony Calocani — Expert Tiling Services" description="Anthony Calocani is a trusted wall and floor tiler in Melbourne. We specialise in bathroom renovations, kitchen splashbacks, waterproofing, grouting, tile repairs and stone installation for residential and commercial projects. Quality craftsmanship, guaranteed.">
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "What types of tiles do you work with?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "We install ceramic, porcelain, marble and natural stone tiles for indoor and outdoor applications across residential and commercial projects in Melbourne. Each material requires specific preparation and sealing techniques, and we have the expertise to handle them all."
					}
				},
				{
					"@type": "Question",
					"name": "Do you handle waterproofing and preparation?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes. Waterproofing is critical for showers, bathrooms, balconies and patios. We apply internal and external waterproofing to Australian Standards. We also handle wall re-sheeting and floor screeding."
					}
				},
				{
					"@type": "Question",
					"name": "What areas of Melbourne do you service?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "We service Melbourne and all surrounding suburbs — from bathroom renovations and patio tiling through to full commercial fit-outs across the greater metro area."
					}
				},
				{
					"@type": "Question",
					"name": "Can you repair or re-grout existing tiles?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes. We carry out tile and stone repairs, re-grouting and caulking for expansion joints. Where the existing tiles are in good condition, we restore the finish without the need for a full replacement."
					}
				},
				{
					"@type": "Question",
					"name": "How do I get a quote for my tiling project?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Send a video enquiry through Tradsiee. It's the fastest way to receive a detailed, obligation-free quote for your project."
					}
				}
			]
		}
	</script>
	<Navbar />
	<main>
		<Hero />
		<About />
		<Services />
		<Process />
		<Portfolio />
		<FAQ />
		<Testimonials />
	</main>
	<Footer />
</Layout>
