---
const year = new Date().getFullYear();
const socialIcons = ["fa-facebook-f", "fa-instagram", "fa-linkedin-in"];
---
<footer id="contact" class="pt-32 pb-16 bg-brand-darker text-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-16 pb-24 border-b border-white/5">
            <div class="lg:col-span-5 space-y-10">
                <div class="space-y-6">
                    <a href="/" class="flex items-center space-x-4 group">
                        <img src="/images/logo.png" alt="Ask Tony" class="h-14 w-auto drop-shadow-xl transition-standard group-hover:scale-110">
                        <span class="text-2xl font-black tracking-tight text-white uppercase">Ask <span class="text-brand-accent">Tony.</span></span>
                    </a>
                    <p class="text-lg text-slate-400 max-w-sm leading-relaxed">Expert wall and floor tiling services in Melbourne. Precision, quality, and reliability in every project.</p>
                </div>
                <div class="flex space-x-4">
                    {socialIcons.map((icon) => (
                        <a href="#" class="w-11 h-11 rounded-2xl bg-white/5 flex items-center justify-center text-slate-400 hover:bg-brand-accent hover:text-white hover:scale-110 transition-standard border border-white/5">
                            <i class={`fab ${icon} text-sm`}></i>
                        </a>
                    ))}
                </div>
            </div>

            <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                <div class="space-y-8">
                    <p class="text-sm font-bold uppercase tracking-[0.2em] text-white">Services</p>
                    <ul class="space-y-4">
                        <li><a href="#portfolio" class="text-slate-400 hover:text-brand-accent transition-colors text-sm font-medium">Project Gallery</a></li>
                        <li><a href="#services" class="text-slate-400 hover:text-brand-accent transition-colors text-sm font-medium">Bathroom Tiling</a></li>
                        <li><a href="#services" class="text-slate-400 hover:text-brand-accent transition-colors text-sm font-medium">Kitchen Splashbacks</a></li>
                        <li><a href="#services" class="text-slate-400 hover:text-brand-accent transition-colors text-sm font-medium">Floor Tiling</a></li>
                    </ul>
                </div>
                <div class="space-y-8">
                    <p class="text-sm font-bold uppercase tracking-[0.2em] text-white">Contact</p>
                    <ul class="space-y-4">
                        <li><p class="text-slate-400 text-sm font-medium">tony@asktony.com.au</p></li>
                        <li><p class="text-slate-400 text-sm font-medium">0400 000 000</p></li>
                    </ul>
                </div>
                <div class="space-y-8">
                    <p class="text-sm font-bold uppercase tracking-[0.2em] text-white">Hours</p>
                    <ul class="space-y-4">
                        <li><p class="text-slate-400 text-sm font-medium">Mon - Fri: 8am - 6pm</p></li>
                        <li><p class="text-slate-400 text-sm font-medium">Saturday: 9am - 4pm</p></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="pt-12 flex flex-col md:flex-row justify-between items-center gap-8">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">
                © {year} Ask Tony Tiling. All Rights Reserved.
            </p>
            <div class="flex items-center space-x-8">
                <a href="#" class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 hover:text-brand-accent transition-colors">Privacy</a>
                <a href="#" class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 hover:text-brand-accent transition-colors">Terms</a>
            </div>
        </div>
    </div>
</footer>

<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous"/>
