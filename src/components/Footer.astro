---
const year = new Date().getFullYear();
---
<footer id="contact" class="pt-32 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="grid lg:grid-cols-12 gap-16 pb-24 reveal-up">
            <div class="lg:col-span-6 space-y-8">
                <div class="space-y-6">
                    <span class="text-3xl font-bold tracking-tighter text-brand-muted uppercase">Anthony <span class="text-brand-accent">Calocani.</span></span>
                    <p class="text-brand-dim max-w-sm">Melbourne's trusted wall and floor tiler. Specialising in ceramic, porcelain, marble and natural stone installation, waterproofing, grouting and tile repairs for residential and commercial projects.</p>
                    <p class="text-brand-dim/60 text-xs">ABN 75 367 275 648 | GST Registered</p>
                </div>

            </div>

            <div class="lg:col-span-6 grid grid-cols-2 md:grid-cols-3 gap-12">
                <div class="space-y-8">
                    <span class="text-xs font-bold uppercase tracking-[0.1em] text-brand-dim">Navigation</span>
                    <ul class="space-y-4">
                        {['About', 'Services', 'FAQ', 'Get a Quote'].map(item => (
                            <li><a href={item === 'Get a Quote' ? '/quote' : `/#${item.toLowerCase()}`} class="text-brand-muted hover:text-brand-accent transition-colors text-sm font-medium uppercase tracking-wider">{item}</a></li>
                        ))}
                    </ul>
                </div>
                <div class="space-y-8">
                    <span class="text-xs font-bold uppercase tracking-[0.1em] text-brand-dim">Contact</span>
                    <ul class="space-y-4">
                            <li><a href="mailto:tony@asktony.com.au" class="text-brand-muted hover:text-brand-accent transition-colors text-sm">tony@asktony.com.au</a></li>
                        <li><a href="tel:+61451644016" class="text-brand-muted hover:text-brand-accent transition-colors text-sm">+61 451 644 016</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="border-t border-white/[0.06]">
        <div class="max-w-7xl mx-auto px-6 lg:px-20 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-brand-dim">&copy; {year} Anthony Calocani. All Rights Reserved.</p>
            <p class="text-sm text-brand-dim">Website made by <a href="https://tomas.gorjux.net" target="_blank" rel="noopener" class="font-bold text-brand-accent hover:text-brand-accent-bright underline underline-offset-2 transition-colors">Tomas Gorjux</a></p>
        </div>
    </div>
</footer>
