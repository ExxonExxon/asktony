---
const features = [
    { title: "Ask Tony Quality", desc: "Premium materials and expert application for a finish that stands the test of time.", icon: "logo.png" },
    { title: "Expert Service", desc: "Dedicated professional tiling with a focus on precision and customer satisfaction.", icon: "logo.png" },
    { title: "Melbourne Trusted", desc: "A local expert you can rely on for honest advice and reliable project delivery.", icon: "logo.png" },
    { title: "15+ Years Exp", desc: "Deep industry knowledge ensuring every project is handled with master craftsmanship.", icon: "logo.png" }
];
---
<section class="py-24 bg-brand-darker text-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
            {features.map((f, index) => (
                <div class="space-y-6 reveal-up" style={`animation-delay: ${index * 100}ms`}>
                    <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center border border-white/10 group overflow-hidden">
                        <img src={`/images/${f.icon}`} alt="Ask Tony" class="w-10 h-10 object-contain transition-standard group-hover:scale-125" />
                    </div>
                    <div class="space-y-3">
                        <h3 class="text-xl font-bold uppercase tracking-tight">{f.title}</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">{f.desc}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
