---
const services = [
    { title: "Lorem Ipsum", img: "project-1.jpg" },
    { title: "Lorem Ipsum", img: "project-2.jpg" },
    { title: "Lorem Ipsum", img: "project-3.jpg" },
    { title: "Lorem Ipsum", img: "project-4.jpg" },
    { title: "Lorem Ipsum", img: "project-5.jpg" },
    { title: "Lorem Ipsum", img: "project-6.jpg" }
];
---
<section id="services" class="section-padding bg-brand-dark">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="mb-24 flex flex-col md:flex-row md:items-end justify-between gap-12 reveal-up">
            <div class="space-y-6">
                <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em] mb-4 block">Services Section</span>
                <h2 class="heading-lg">Lorem Ipsum <br>Dolor Sit Amet.</h2>
            </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
            {services.map((service, index) => (
                <div class="group relative aspect-[4/5] overflow-hidden rounded-3xl shadow-soft border border-white/[0.04] reveal-up" style={`animation-delay: ${index * 100}ms`}>
                    <img src={`/images/portfolio/${service.img}`} alt={service.title} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-base/95 via-brand-base/20 to-transparent flex flex-col justify-end p-8 lg:p-12">
                        <h3 class="text-2xl font-bold text-white tracking-tight leading-none mb-4">{service.title}</h3>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
