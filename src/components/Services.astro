---
const services = [
    { title: "Tile & Stone Installation", desc: "Professional installation of ceramic, porcelain, marble and natural stone tiles for floors, walls and feature areas across Melbourne residential and commercial spaces.", img: "tile-stone-installation.jpg" },
    { title: "Bathroom Renovations", desc: "Complete Melbourne bathroom tiling including wall and floor installation, waterproofing and finishing. Creating bathrooms that are both beautiful and built to last.", img: "bathroom-renovations.jpg" },
    { title: "Kitchen Splashbacks", desc: "Clean, precisely installed kitchen splashbacks in ceramic, porcelain, marble or glass. A practical and stylish finish that protects your walls and transforms your kitchen.", img: "kitchen-splashbacks.jpg" },
    { title: "Waterproofing", desc: "Internal and external waterproofing to Australian Standards for showers, bathrooms, balconies and patios across Melbourne. Essential protection against moisture damage.", img: "waterproofing.jpg" },
    { title: "Grouting & Sealing", desc: "Professional grouting, re-grouting and sealing for tiles and natural stone across Melbourne. Proper sealing protects against moisture, stains and everyday wear.", img: "grouting-sealing.jpg" },
    { title: "Tile Repairs", desc: "Expert tile and stone repairs including replacement, re-grouting and caulking in Melbourne. Where tiles are sound, we restore the finish without full replacement.", img: "tile-repairs.jpg" }
];
---
<section id="services" class="section-padding bg-brand-base">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="mb-24 reveal-up">
            <h2 class="heading-lg">Tiling Services.</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
            {services.map((service, index) => (
                <div class="group reveal-up" style={`animation-delay: ${index * 50}ms`}>
                    <div class="aspect-[4/3] overflow-hidden rounded-3xl glass-card !p-1.5">
                        <img src={`/images/services/${service.img}`} alt={service.title} loading="lazy" class="w-full h-full object-cover rounded-2xl transition-transform duration-300" />
                    </div>
                    <h3 class="text-3xl font-bold text-brand-muted tracking-tight leading-none mt-6">{service.title}</h3>
                    <p class="text-base text-brand-dim leading-relaxed mt-3">{service.desc}</p>
                </div>
            ))}
        </div>
    </div>
</section>
