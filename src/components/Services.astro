---
const services = [
    { title: "Lorem Ipsum", img: "portfolio/hero/modern-monochrome-bathroom-finish.jpg" },
    { title: "Lorem Ipsum", img: "portfolio/hero/luxury-herringbone-bath-suite.jpg" },
    { title: "Lorem Ipsum", img: "portfolio/hero/designer-blue-mosaic-kitchen.jpg" },
    { title: "Lorem Ipsum", img: "portfolio/hero/designer-blue-mosaic-kitchen.jpg" },
    { title: "Lorem Ipsum", img: "portfolio/hero/premium-outdoor-terrace-stone.jpg" },
    { title: "Lorem Ipsum", img: "portfolio/hero/architectural-outdoor-curved-stairs.jpg" }
];
---
<section id="services" class="section-padding">
    <div class="max-w-7xl mx-auto px-6">
        <div class="mb-24 flex flex-col md:flex-row md:items-end justify-between gap-12 reveal-up">
            <h2 class="heading-lg">Lorem Ipsum <br>Dolor Sit Amet.</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
            {services.map((service, index) => (
                <div class="group relative aspect-[4/5] overflow-hidden rounded-3xl shadow-soft reveal-up" style={`animation-delay: ${index * 100}ms`}>
                    <img src={`/images/${service.img}`} alt={service.title} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-darker/90 via-brand-darker/20 to-transparent flex flex-col justify-end p-8 lg:p-12">
                        <h3 class="text-2xl font-bold text-white tracking-tight leading-none mb-4">{service.title}</h3>
                        <div class="h-1 w-0 bg-brand-accent group-hover:w-full transition-standard duration-700"></div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
