---
---
<section id="about" class="section-padding relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-16 lg:gap-24 items-center">
            <div class="lg:col-span-6 reveal-up">
                <div class="relative">
                    <div class="absolute -top-10 -left-10 w-40 h-40 bg-brand-accent/5 rounded-full -z-10 animate-pulse"></div>
                    <img src="/images/tony.jpg" alt="Ask Tony" class="w-full h-auto rounded-3xl shadow-heavy" />
                    <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-white/40 backdrop-blur-md rounded-3xl shadow-soft -z-10 hidden lg:block border border-white/40"></div>
                </div>
            </div>
            <div class="lg:col-span-6 space-y-10 reveal-up" style="animation-delay: 300ms">
                <div class="space-y-4">
                    <h2 class="heading-md">Ask Tony: Precision Tiling for Your Home and Business.</h2>
                </div>
                <div class="space-y-6 text-readable">
                    <p>
                        We specialize in transforming spaces through expert tiling. Whether it's a modern bathroom renovation or a large commercial development, Ask Tony delivers excellence.
                    </p>
                    <ul class="space-y-4">
                        {[1, 2, 3].map(() => (
                            <li class="flex items-start space-x-4 group">
                                <img src="/images/logo.png" alt="Ask Tony" class="w-6 h-6 object-contain mt-0.5 opacity-60 group-hover:opacity-100 transition-standard" />
                                <span class="text-slate-700 font-medium">Professional finish with meticulous attention to detail.</span>
                            </li>
                        ))}
                    </ul>
                </div>
                <div class="pt-4">
                    <a href="#" class="btn-secondary">Learn More</a>
                </div>
            </div>
        </div>
    </div>
</section>
