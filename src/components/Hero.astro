---
---
<section class="relative min-h-screen flex items-center overflow-hidden bg-white pt-20">
	<div class="absolute inset-0 z-0">
		<img src="/images/portfolio/hero-image.webp" alt="" class="w-full h-full object-cover">
		<div class="absolute inset-0 bg-black/35"></div>
	</div>

	<div class="max-w-7xl mx-auto px-6 lg:px-20 w-full relative z-10">
		<div class="grid lg:grid-cols-12 gap-12 items-center">
			<div class="lg:col-span-12 space-y-8 relative">
				<div class="reveal-up">
					<h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.9] text-white">
						ANTHONY <br>
						<span class="text-brand-accent-bright italic font-light">CALOCANI.</span>
					</h1>
				</div>

				<div class="flex flex-wrap items-center gap-3 reveal-up" style="animation-delay: 100ms">
					<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 border border-white/25 text-xs font-bold text-white uppercase tracking-wider backdrop-blur-sm">
						<i class="fas fa-shield-alt text-[10px] text-brand-accent-bright"></i>
						Licensed &amp; Insured
					</span>
					<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 border border-white/25 text-xs font-bold text-white uppercase tracking-wider backdrop-blur-sm">
						<i class="fas fa-calendar-check text-[10px] text-brand-accent-bright"></i>
						6 Years Experience
					</span>
				</div>

				<div class="max-w-xl space-y-8 reveal-up" style="animation-delay: 200ms">
					<p class="text-readable text-white/90">
						Wall and floor tiling across Melbourne. Bathrooms, kitchens, patios and commercial spaces. Send a video enquiry for a free quote.
					</p>
					<div class="flex items-center gap-6 pt-2">
						<a href="/quote" class="btn-primary">Get a Free Quote</a>
						<a href="/#services" class="text-xs font-bold text-white hover:text-white/80 transition-colors uppercase tracking-[0.1em] border-b-2 border-white/50 pb-0.5">Our Services</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
