---
<section class="relative min-h-screen flex items-center overflow-hidden">
    <!-- Full-width background image -->
    <div class="absolute inset-0 z-0">
        <img src="https://placehold.co/1920x1080?text=Hero+Background+Image" alt="Hero Placeholder" class="w-full h-full object-cover">
        <!-- Overlay for readability -->
        <div class="absolute inset-0 bg-white/60"></div>
    </div>

    <div class="max-w-[1600px] mx-auto px-6 lg:px-20 w-full relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-12 space-y-12 relative">
                <div class="space-y-4 reveal-up">
                    <span class="text-[10px] font-bold text-brand-accent uppercase tracking-[0.5em] block">Hero Section</span>
                    <h1 class="heading-xl">
                        LOREM <br>
                        <span class="text-brand-accent italic font-light">IPSUM.</span>
                    </h1>
                </div>

                <div class="max-w-xl space-y-10 reveal-up" style="animation-delay: 200ms">
                    <p class="text-readable">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.
                    </p>
                    <div class="flex items-center gap-8">
                        <a href="#" class="btn-primary">Lorem Ipsum</a>
                        <a href="#" class="text-[10px] font-bold text-brand-dark hover:text-brand-accent transition-colors uppercase tracking-[0.2em] border-b border-brand-dark/20 pb-1">Lorem Ipsum</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
