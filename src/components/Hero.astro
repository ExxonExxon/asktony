---
---
<section class="relative min-h-[90vh] lg:h-screen w-full flex items-center justify-center overflow-hidden">
    <!-- Background Image with center positioning -->
    <div class="absolute inset-0 z-0">
        <img src="/images/header.jpg" alt="Ask Tony Header" class="w-full h-full object-cover object-center scale-105">
        <!-- Modern gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-brand-darker/70 via-brand-darker/50 to-brand-darker/80"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 text-center space-y-12 reveal-up">
        <div class="space-y-6">
            <h1 class="heading-xl drop-shadow-2xl uppercase">
                ASK TONY.<br>
                <span class="text-brand-accent">EXPERT TILING.</span>
            </h1>
        </div>

        <p class="text-lg lg:text-2xl text-slate-200 max-w-3xl mx-auto leading-relaxed font-medium opacity-90">
            Professional wall and floor tiling services in Melbourne. Expert craftsmanship, premium materials, and a finish that lasts a lifetime.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 pt-4">
            <a href="#" class="btn-primary w-full sm:w-auto">
                Get a Quote
            </a>
            <a href="#services" class="px-10 py-5 border border-white/20 text-white text-[12px] font-bold rounded-2xl hover:bg-white/10 transition-standard uppercase tracking-[0.1em] backdrop-blur-md w-full sm:w-auto">
                Our Services
            </a>
        </div>
    </div>
</section>
