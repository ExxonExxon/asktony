---
---
<section class="relative min-h-screen flex items-center overflow-hidden pt-20">
	<div class="absolute inset-0 z-0">
		<img src="/images/portfolio/hero-image.webp" alt="Anthony Calonaci — professional wall and floor tiler Melbourne" class="w-full h-full object-cover">
		<div class="absolute inset-0 bg-brand-base/60"></div>
	</div>

	<div class="max-w-7xl mx-auto px-6 lg:px-20 w-full relative z-10">
		<div class="grid lg:grid-cols-12 gap-12 items-center">
			<div class="lg:col-span-12 space-y-8 relative">
				<div class="reveal-up">
					<h1 class="text-[clamp(2rem,9vw,3rem)] sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.9] text-brand-muted">
						ANTHONY CALOCANI <br>
						<span class="text-brand-accent-bright italic font-light">Wall &amp; Floor Tiler — Melbourne</span>
					</h1>
				</div>

				<div class="flex flex-wrap items-center gap-3 reveal-up" style="animation-delay: 100ms">
					<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-brand-muted uppercase tracking-wider backdrop-blur-lg">
						<i class="fas fa-shield-alt text-[10px] text-brand-accent-bright"></i>
						Licensed &amp; Insured
					</span>
					<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-brand-muted uppercase tracking-wider backdrop-blur-lg">
						<i class="fas fa-calendar-check text-[10px] text-brand-accent-bright"></i>
						6 Years Experience
					</span>
				</div>

				<div class="max-w-xl space-y-8 reveal-up" style="animation-delay: 200ms">
					<p class="text-readable text-brand-muted/90">
						Your trusted wall and floor tiler in Melbourne, specialising in bathroom renovations, kitchen splashbacks, waterproofing, grouting and tile repairs for residential and commercial projects — expert craftsmanship for every space.
					</p>
					<div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 pt-2">
						<a href="/quote" class="btn-primary w-full sm:w-auto text-center">Get a Free Quote</a>
						<a href="/#services" class="text-sm sm:text-xs font-bold text-brand-muted hover:text-brand-accent transition-colors uppercase tracking-[0.1em] border-b-2 border-brand-muted/40 pb-0.5">Our Services</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
