---
---
<section class="relative min-h-screen flex items-center overflow-hidden bg-white">
    <!-- Full-width background image -->
    <div class="absolute inset-0 z-0">
        <img src="/images/portfolio/project-6.jpg" alt="" class="w-full h-full object-cover">
        <!-- Overlay for readability -->
        <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-20 w-full relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-12 space-y-12 relative">
                <div class="reveal-up">
                    <h1 class="heading-xl text-white">
                        TILE <br>
                        <span class="text-brand-accent-bright italic font-light">&amp; STONE.</span>
                    </h1>
                </div>

                <div class="max-w-xl space-y-10 reveal-up" style="animation-delay: 200ms">
                    <p class="text-readable text-white">
                        Premium tile and stone installation across Melbourne — from complete bathroom renovations and kitchen splashbacks to outdoor patios and commercial fit-outs. Record a short video of your project and we'll quote it without a site visit.
                    </p>
                    <div class="flex items-center gap-8">
                        <a href="/#portfolio" class="btn-primary">View Our Work</a>
                        <a href="/contact" class="text-xs font-bold text-white/70 hover:text-white transition-colors uppercase tracking-[0.1em] border-b border-white/30 pb-1">Get a Quote</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
