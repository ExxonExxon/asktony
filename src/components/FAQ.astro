---
const faqs = [
  {
    question: "What types of tiles do you work with?",
    answer: "We install ceramic, porcelain, marble, and natural stone tiles across all environments — indoor, outdoor, residential, and commercial. Every material has its own preparation and sealing requirements, and we ensure the correct approach is taken for each."
  },
  {
    question: "Do you handle waterproofing and preparation?",
    answer: "Yes. Waterproofing is critical for wet areas such as showers, bathrooms, balconies, and patios. We apply internal and external waterproofing membranes in accordance with Australian Standards before any tiling begins, and we also manage structural preparation including wall re-sheeting and cement floor screeding."
  },
  {
    question: "What areas of Melbourne do you service?",
    answer: "We cover Melbourne and surrounding suburbs for both residential and commercial projects. Whether you're renovating a single bathroom, tiling a new patio, or fitting out a commercial space, we're equipped to deliver across the metro area."
  },
  {
    question: "Can you repair or re-grout existing tiles?",
    answer: "Absolutely. We offer tile and stone repairs, re-grouting of old or worn grout lines, and silicone and polyurethane caulking for expansion joints. If the existing tiles are sound, we can restore the finish without a full replacement — saving time and preserving your surfaces."
  },
  {
    question: "How do I get a quote for my project?",
    answer: "Send a video enquiry through Tradsiee — fastest way to get a quote. Quotes are detailed and obligation-free."
  }
];
---

<section id="faq" class="section-padding bg-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="grid lg:grid-cols-12 gap-16 lg:gap-24">
            <div class="lg:col-span-4 reveal-up">
                <div class="space-y-6">
                    <h2 class="heading-lg">FAQ.</h2>
                    <p class="text-readable">
                        Everything you need to know about our tiling services. If you can't find the answer here, feel free to reach out directly.
                    </p>
                </div>
            </div>

            <div class="lg:col-span-8 space-y-4">
                {faqs.map((faq, index) => (
                    <div class="faq-item group bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 reveal-up" style={`animation-delay: ${index * 100}ms`}>
                        <button class="faq-trigger w-full px-8 py-6 text-left flex items-center justify-between">
                            <span class="text-lg font-bold text-gray-900 transition-colors">{faq.question}</span>
                            <div class="relative w-6 h-6 flex items-center justify-center">
                                <span class="absolute w-4 h-0.5 bg-gray-400 transition-transform duration-300"></span>
                                <span class="absolute w-0.5 h-4 bg-gray-400 transition-transform duration-300"></span>
                            </div>
                        </button>
                        <div class="faq-content max-h-0 opacity-0 overflow-hidden transition-all duration-500 ease-in-out">
                            <div class="px-8 pb-8 text-gray-700 leading-relaxed">
                                {faq.answer}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content');
        const iconVertical = item.querySelector('.faq-trigger span:last-child');

        trigger?.addEventListener('click', () => {
            const isOpen = !content?.classList.contains('max-h-0');

            // Close all others
            faqItems.forEach(otherItem => {
                if (otherItem !== item) {
                    otherItem.querySelector('.faq-content')?.classList.add('max-h-0', 'opacity-0');
                    otherItem.querySelector('.faq-content')?.classList.remove('max-h-[500px]', 'opacity-100');
                    otherItem.querySelector('.faq-trigger span:last-child')?.classList.remove('rotate-90', 'opacity-0');
                }
            });

            // Toggle current
            if (isOpen) {
                content?.classList.add('max-h-0', 'opacity-0');
                content?.classList.remove('max-h-[500px]', 'opacity-100');
                iconVertical?.classList.remove('rotate-90', 'opacity-0');
            } else {
                content?.classList.remove('max-h-0', 'opacity-0');
                content?.classList.add('max-h-[500px]', 'opacity-100');
                iconVertical?.classList.add('rotate-90', 'opacity-0');
            }
        });
    });
</script>
