---
const faqs = [
  {
    question: "What types of tiles do you work with?",
    answer: "We install ceramic, porcelain, marble and natural stone tiles for indoor and outdoor applications across residential and commercial projects. Each material requires specific preparation and sealing techniques, and we have the expertise to handle them all."
  },
  {
    question: "Do you handle waterproofing and preparation?",
    answer: "Yes. Waterproofing is critical for showers, bathrooms, balconies and patios. We apply internal and external waterproofing to Australian Standards. We also handle wall re-sheeting and floor screeding."
  },
  {
    question: "What areas of Melbourne do you service?",
    answer: "We service Melbourne and all surrounding suburbs — from bathroom renovations, waterproofing and patio tiling through to full commercial fit-outs across the greater metro area."
  },
  {
    question: "Can you repair or re-grout existing tiles?",
    answer: "Yes. We carry out tile and stone repairs, re-grouting and caulking for expansion joints across Melbourne. Where the existing tiles are in good condition, we restore the finish without the need for a full replacement."
  },
  {
    question: "How do I get a quote for my project?",
    answer: "Send a video enquiry through Tradsiee. It's the fastest way to receive a detailed, obligation-free quote for your project."
  }
];
---

<section id="faq" class="section-padding bg-brand-surface">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="grid lg:grid-cols-12 gap-16 lg:gap-24">
            <div class="lg:col-span-4 reveal-up">
                <div class="space-y-6">
                    <h2 class="heading-lg">Tiling FAQ.</h2>
                    <p class="text-readable">
                        Everything you need to know about our Melbourne wall and floor tiling services. If you cannot find the answer here, please feel free to reach out directly.
                    </p>
                </div>
            </div>

            <div class="lg:col-span-8 space-y-4">
                {faqs.map((faq, index) => (
                    <div class="faq-item group glass-card overflow-hidden transition-all duration-300 reveal-up" style={`animation-delay: ${index * 100}ms`}>
                        <button class="faq-trigger w-full px-8 py-6 text-left flex items-center justify-between">
                            <span class="text-lg font-bold text-brand-muted transition-colors">{faq.question}</span>
                            <div class="relative w-6 h-6 flex items-center justify-center">
                                <span class="absolute w-4 h-0.5 bg-brand-dim transition-transform duration-300"></span>
                                <span class="absolute w-0.5 h-4 bg-brand-dim transition-transform duration-300"></span>
                            </div>
                        </button>
                        <div class="faq-content grid transition-all duration-500 ease-in-out" style="grid-template-rows: 0fr; opacity: 0;">
                            <div class="overflow-hidden min-h-0">
                                <div class="px-8 pb-8 text-brand-dim leading-relaxed">
                                    {faq.answer}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content');
        const iconVertical = item.querySelector('.faq-trigger span:last-child');

        trigger?.addEventListener('click', () => {
            const isOpen = content?.style.gridTemplateRows === '1fr';

            // Close all others
            faqItems.forEach(otherItem => {
                const otherContent = otherItem.querySelector('.faq-content');
                const otherIcon = otherItem.querySelector('.faq-trigger span:last-child');
                if (otherItem !== item && otherContent) {
                    otherContent.style.gridTemplateRows = '0fr';
                    otherContent.style.opacity = '0';
                    otherIcon?.classList.remove('rotate-90', 'opacity-0');
                }
            });

            // Toggle current
            if (isOpen) {
                content.style.gridTemplateRows = '0fr';
                content.style.opacity = '0';
                iconVertical?.classList.remove('rotate-90', 'opacity-0');
            } else {
                content.style.gridTemplateRows = '1fr';
                content.style.opacity = '1';
                iconVertical?.classList.add('rotate-90', 'opacity-0');
            }
        });
    });
</script>
