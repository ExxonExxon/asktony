---
const projects = [
    { img: "/images/portfolio/project-1.jpg", title: "Lorem Ipsum" },
    { img: "/images/portfolio/project-2.jpg", title: "Lorem Ipsum" },
    { img: "/images/portfolio/project-3.jpg", title: "Lorem Ipsum" },
    { img: "/images/portfolio/project-4.jpg", title: "Lorem Ipsum" },
    { img: "/images/portfolio/project-5.jpg", title: "Lorem Ipsum" },
    { img: "/images/portfolio/project-6.jpg", title: "Lorem Ipsum" }
];
---
<section id="portfolio" class="section-padding bg-brand-surface">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-12 mb-24 reveal-up">
            <div class="space-y-6">
                <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em] mb-4 block">Portfolio Section</span>
                <h2 class="heading-lg">Lorem Ipsum <br>Dolor Sit.</h2>
            </div>
            <p class="text-readable max-w-md">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
            {projects.map((item, index) => (
                <div class="group space-y-6 reveal-up" style={`animation-delay: ${index * 100}ms`}>
                    <div class="aspect-[4/5] overflow-hidden rounded-2xl shadow-soft border border-white/[0.04]">
                        <img src={item.img} alt={item.title} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                    </div>
                    <div class="flex items-center justify-between border-b border-white/[0.06] pb-6">
                        <h3 class="text-lg font-bold text-white uppercase tracking-tight">{item.title}</h3>
                        <span class="text-xs font-bold text-brand-accent uppercase tracking-wider">View</span>
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-24 text-center reveal-up">
            <a href="#" class="btn-secondary">Lorem Ipsum</a>
        </div>
    </div>
</section>
