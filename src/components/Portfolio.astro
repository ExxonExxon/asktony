---
---
<section id="portfolio" class="section-padding bg-white relative overflow-hidden">
    <!-- Background Branding -->
    <div class="absolute -right-20 top-40 text-[15vw] font-black text-slate-50/80 -z-10 select-none rotate-90">GALLERY</div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-12 mb-24 reveal-up">
            <div class="space-y-6">
                <div class="flex items-center space-x-3">
                    <img src="/images/logo.png" alt="Ask Tony" class="w-8 h-8 object-contain" />
                    <span class="text-[11px] font-bold text-brand-accent uppercase tracking-[0.4em]">Master Craftsmanship</span>
                </div>
                <h2 class="heading-lg">Our Recent <br>Tiling Projects.</h2>
            </div>
            <p class="text-xl text-slate-500 max-w-md font-medium leading-relaxed">
                Take a look at our precision work. From flawless mitred edges to large-scale luxury installations, we set the standard in Melbourne.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8">
            <!-- Featured Large Item -->
            <div class="md:col-span-8 group relative aspect-[16/9] overflow-hidden rounded-3xl shadow-soft reveal-up">
                <img src="/images/portfolio/project-1.jpg" alt="Luxury Tiling Melbourne" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-darker/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-standard duration-700 p-10 flex flex-col justify-end">
                    <p class="text-white font-bold text-xl uppercase tracking-tight">Luxury Bathroom Renovation</p>
                </div>
            </div>

            <!-- Side Small Items -->
            <div class="md:col-span-4 group relative aspect-square md:aspect-auto overflow-hidden rounded-3xl shadow-soft reveal-up" style="animation-delay: 200ms">
                <img src="/images/portfolio/mitre-1.jpg" alt="Precision Mitre Edge" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                <div class="absolute inset-0 bg-brand-accent/20 opacity-0 group-hover:opacity-100 transition-standard flex items-center justify-center backdrop-blur-sm">
                    <div class="bg-white/90 p-6 rounded-2xl shadow-xl scale-90 group-hover:scale-100 transition-standard">
                        <p class="text-brand-dark font-bold text-sm uppercase tracking-widest">Precision Mitring</p>
                    </div>
                </div>
            </div>

            <!-- Bottom Row -->
            <div class="md:col-span-4 group relative aspect-[4/5] overflow-hidden rounded-3xl shadow-soft reveal-up" style="animation-delay: 300ms">
                <img src="/images/portfolio/project-2.jpg" alt="Commercial Tiling" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
            </div>

            <div class="md:col-span-4 group relative aspect-[4/5] overflow-hidden rounded-3xl shadow-soft reveal-up" style="animation-delay: 400ms">
                <img src="/images/portfolio/project-3.jpg" alt="Floor Tiling Melbourne" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
            </div>

            <div class="md:col-span-4 group relative aspect-[4/5] overflow-hidden rounded-3xl shadow-soft reveal-up" style="animation-delay: 500ms">
                <img src="/images/portfolio/project-4.jpg" alt="Outdoor Tiling" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
            </div>
        </div>

        <div class="mt-20 text-center reveal-up">
            <a href="#" class="btn-secondary group">
                <span>View Full Portfolio</span>
                <i class="fas fa-chevron-right ml-3 text-[10px] group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
    </div>
</section>
