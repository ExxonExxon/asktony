---
import { projects } from '../data/projects';

const mainProjects = projects.filter((p) => p.slug !== 'premium-residences');
const residential = projects.find((p) => p.slug === 'premium-residences');
---

<section id="portfolio" class="section-padding bg-brand-base">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 md:gap-12 mb-16 md:mb-24">
      <div class="reveal-up">
        <h2 class="heading-lg">Projects.</h2>
      </div>
      <p class="text-readable max-w-md reveal-up" style="animation-delay: 150ms">
        Explore a selection of our recent tiling projects across Melbourne — from educational
        facilities and aged care residences through to commercial spaces and private homes.
        Every project is completed with precision and care to the highest standard.
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 xl:gap-10">
      <div class="grid flex-1 grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 xl:gap-10">
        {mainProjects.map((item, index) => (
          <a
            href={`/portfolio/${item.slug}`}
            class="group glass-card overflow-hidden reveal-up block"
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="aspect-[4/5] overflow-hidden">
              {item.images.length > 0 ? (
                <img
                  src={item.images[0]}
                  alt={item.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <div class="text-brand-dim text-sm font-medium uppercase tracking-wider">Photos Coming Soon</div>
                </div>
              )}
            </div>
            <div class="p-5 md:p-6">
              <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em] mb-2 block">{item.category}</span>
              <h3 class="text-lg font-bold text-brand-muted uppercase tracking-tight">{item.name}</h3>
            </div>
          </a>
        ))}
      </div>

      {residential && (
        <a
          href={`/portfolio/${residential.slug}`}
          class="group glass-card overflow-hidden reveal-up block lg:w-[42%]"
        >
          <div class="aspect-[4/5] md:aspect-[4/3] lg:aspect-[3/5] overflow-hidden">
            {residential.images.length > 0 ? (
              <img
                src={residential.images[0]}
                alt={residential.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <div class="text-brand-dim text-sm font-medium uppercase tracking-wider">Photos Coming Soon</div>
              </div>
            )}
          </div>
          <div class="p-5 md:p-6 lg:p-8">
            <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em] mb-2 block">{residential.category}</span>
            <h3 class="text-xl lg:text-2xl font-bold text-brand-muted uppercase tracking-tight">{residential.name}</h3>
          </div>
        </a>
      )}
    </div>
  </div>
</section>
