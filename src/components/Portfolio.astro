---
import { projects } from '../data/projects';
---

<section id="portfolio" class="section-padding bg-gray-100">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 md:gap-12 mb-16 md:mb-24">
      <div class="reveal-up">
        <h2 class="heading-lg">Projects.</h2>
      </div>
      <p class="text-readable max-w-md reveal-up" style="animation-delay: 150ms">
        Browse a selection of our recent work across Melbourne — from educational
        facilities and aged care to residential and commercial spaces. Every project
        completed to the highest standard.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 lg:gap-10">
      {projects.map((item, index) => (
        <a
          href={`/portfolio/${item.slug}`}
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-500 hover:border-brand-accent/30 hover:shadow-soft reveal-up block"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="aspect-[4/5] overflow-hidden bg-gray-100">
            {item.images.length > 0 ? (
              <img
                src={item.images[0]}
                alt={item.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <div class="text-brand-dim text-sm font-medium uppercase tracking-wider">Photos Coming Soon</div>
              </div>
            )}
          </div>
          <div class="p-5 md:p-6">
            <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em] mb-2 block">{item.category}</span>
            <h3 class="text-lg font-bold text-gray-900 uppercase tracking-tight">{item.name}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
