---
const projects = [
    { img: "/images/portfolio/project-1.jpg", title: "Marble Bathroom" },
    { img: "/images/portfolio/project-2.jpg", title: "Porcelain Patio" },
    { img: "/images/portfolio/project-3.jpg", title: "Kitchen Splashback" },
    { img: "/images/portfolio/project-4.jpg", title: "Herringbone Floor" },
    { img: "/images/portfolio/project-5.jpg", title: "Balcony Tiling" },
    { img: "/images/portfolio/project-6.jpg", title: "Commercial Lobby" }
];
---
<section id="portfolio" class="section-padding bg-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 md:gap-12 mb-16 md:mb-24">
                <div class="reveal-up">
                    <h2 class="heading-lg">Projects.</h2>
                </div>
            <p class="text-readable max-w-md reveal-up" style="animation-delay: 150ms">
                Browse a selection of our recent work across Melbourne — bathrooms, kitchens, outdoor areas and commercial spaces. Every project completed to the highest standard.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 lg:gap-10">
            {projects.map((item, index) => (
                <div class="group bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-500 hover:border-brand-accent/30 hover:shadow-soft reveal-up" style={`animation-delay: ${index * 100}ms`}>
                    <div class="aspect-[4/5] overflow-hidden">
                        <img src={item.img} alt={item.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </div>
                    <div class="p-5 md:p-6 space-y-4">
                        <h3 class="text-lg font-bold text-gray-900 uppercase tracking-tight">{item.title}</h3>
                        <a href="#" class="inline-flex items-center gap-2 text-xs font-bold text-brand-accent uppercase tracking-wider hover:text-brand-accent-bright transition-colors">
                            Read More
                            <i class="fas fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-16 md:mt-24 text-center reveal-up">
            <a href="/quote" class="btn-secondary">Start Your Project</a>
        </div>
    </div>
</section>
