---
const sections = [
	{ label: 'About', href: '/#about' },
	{ label: 'Services', href: '/#services' },
	{ label: 'Portfolio', href: '/#portfolio' },
	{ label: 'FAQ', href: '/#faq' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-brand-dark/80 backdrop-blur-xl border-b border-white/[0.06]">
	<div class="max-w-7xl mx-auto px-6 lg:px-20 flex items-center justify-between h-20">
		<a href="/" class="text-lg md:text-xl font-bold tracking-tighter uppercase text-brand-muted">
			Anthony
		</a>

		<div class="hidden md:flex items-center gap-8">
			{sections.map((s) => (
				<a
					href={s.href}
					class="text-xs font-bold text-brand-dim hover:text-brand-accent transition-colors uppercase tracking-[0.1em]"
				>
					{s.label}
				</a>
			))}
			<a href="/quote" class="btn-primary !py-3 !px-7">Get a Quote</a>
		</div>

		<button
			id="mobile-menu-button"
			class="md:hidden w-10 h-10 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center text-brand-muted focus:outline-none"
			aria-label="Toggle Menu"
		>
			<div class="w-4 h-3 relative flex flex-col justify-between">
				<span id="hamburger-top" class="w-full h-0.5 bg-current block transition-all duration-300 origin-left"></span>
				<span id="hamburger-middle" class="w-full h-0.5 bg-current block transition-all duration-300"></span>
				<span id="hamburger-bottom" class="w-full h-0.5 bg-current block transition-all duration-300 origin-left"></span>
			</div>
		</button>
	</div>

	<!-- Mobile Backdrop -->
	<div id="mobile-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300" style="display: none"></div>

	<!-- Mobile Drawer -->
	<div id="mobile-drawer" class="fixed top-0 right-0 h-full w-[80vw] max-w-sm bg-brand-surface border-l border-white/[0.06] shadow-heavy translate-x-full transition-transform duration-300 ease-out" style="z-index: 45; display: none">
		<div class="flex items-center justify-between px-6 h-20 border-b border-white/[0.06]">
			<span class="text-xs font-bold tracking-[0.15em] text-brand-dim uppercase">Navigation</span>
			<button id="mobile-close" class="w-8 h-8 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center text-brand-dim hover:text-brand-muted transition-colors">
				<i class="fas fa-times text-xs"></i>
			</button>
		</div>
		<nav class="flex flex-col px-6 pt-6 space-y-1">
			{[...sections, { label: 'Get a Quote', href: '/quote' }].map((item) => (
				<a
					href={item.href}
					class="mobile-nav-link block py-4 text-base font-medium text-brand-dim hover:text-brand-accent transition-colors border-b border-white/[0.06] opacity-0 translate-x-4"
				>
					{item.label}
				</a>
			))}
			<a href="/quote" class="btn-primary text-center mt-6 !py-4">Get a Quote</a>
		</nav>
	</div>
</nav>

<script>
	const mobileMenuButton = document.getElementById('mobile-menu-button');
	const mobileClose = document.getElementById('mobile-close');
	const mobileBackdrop = document.getElementById('mobile-backdrop');
	const mobileDrawer = document.getElementById('mobile-drawer');
	const hamburgerTop = document.getElementById('hamburger-top');
	const hamburgerMiddle = document.getElementById('hamburger-middle');
	const hamburgerBottom = document.getElementById('hamburger-bottom');

	let isMenuOpen = false;

	function openMenu() {
		isMenuOpen = true;
		document.body.style.overflow = 'hidden';

		mobileBackdrop.style.display = '';
		mobileDrawer.style.display = '';
		void mobileDrawer?.offsetHeight;

		mobileBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
		mobileDrawer?.classList.remove('translate-x-full');

		hamburgerTop?.classList.add('rotate-[42deg]', 'translate-x-[2px]');
		hamburgerMiddle?.classList.add('opacity-0', '-translate-x-2');
		hamburgerBottom?.classList.add('-rotate-[42deg]', 'translate-x-[2px]');

		document.querySelectorAll('.mobile-nav-link').forEach((link, i) => {
			setTimeout(() => {
				link.classList.remove('opacity-0', 'translate-x-4');
			}, 80 + i * 60);
		});
	}

	function closeMenu() {
		if (!isMenuOpen) return;
		isMenuOpen = false;
		document.body.style.overflow = '';

		const navLinks = document.querySelectorAll('.mobile-nav-link');

		navLinks.forEach((link, i) => {
			setTimeout(() => {
				link.classList.add('opacity-0', 'translate-x-4');
			}, (navLinks.length - 1 - i) * 60);
		});

		setTimeout(() => {
			mobileBackdrop?.classList.add('opacity-0', 'pointer-events-none');
			mobileDrawer?.classList.add('translate-x-full');
		}, (navLinks.length - 1) * 60);

		hamburgerTop?.classList.remove('rotate-[42deg]', 'translate-x-[2px]');
		hamburgerMiddle?.classList.remove('opacity-0', '-translate-x-2');
		hamburgerBottom?.classList.remove('-rotate-[42deg]', 'translate-x-[2px]');
	}

	mobileMenuButton?.addEventListener('click', () => {
		if (isMenuOpen) closeMenu();
		else openMenu();
	});

	mobileClose?.addEventListener('click', closeMenu);
	mobileBackdrop?.addEventListener('click', closeMenu);

	document.querySelectorAll('.mobile-nav-link').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	const mql = window.matchMedia('(min-width: 768px)');
	mql.addEventListener('change', (e) => {
		if (e.matches && isMenuOpen) closeMenu();
	});
</script>
