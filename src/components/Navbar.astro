---
---
<nav id="main-nav" class="fixed top-0 left-0 w-full z-[100] transition-all duration-500">
    <div id="nav-container" class="px-6 lg:px-20 py-6 lg:py-8 flex items-center justify-between transition-all duration-500">
        <!-- Logo -->
        <a href="/" class="flex items-center space-x-3 group relative z-[110]">
            <span class="text-xl lg:text-2xl font-bold tracking-tighter text-brand-dark uppercase">Lorem <span class="text-brand-accent">Ipsum.</span></span>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-10">
            {[
                { label: 'Portfolio', href: '/#portfolio' },
                { label: 'About', href: '/#about' },
                { label: 'Process', href: '/#how-it-works' }
            ].map((item) => (
                <a href={item.href} class="nav-link text-sm font-bold text-brand-muted hover:text-brand-dark transition-colors uppercase tracking-wider relative py-2 overflow-hidden group">
                    <span class="relative z-10">{item.label}</span>
                    <span class="absolute bottom-0 left-0 w-full h-0.5 bg-brand-accent transform translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-300"></span>
                </a>
            ))}
            <a href="/contact" class="btn-primary !py-3 !px-8">
                Contact Tony
            </a>
        </div>

        <!-- Mobile Button -->
        <div class="md:hidden relative z-[110]">
            <button id="mobile-menu-button" class="text-brand-dark focus:outline-none p-2" aria-label="Toggle Menu">
                <div class="w-6 h-5 relative flex flex-col justify-between">
                    <span id="hamburger-top" class="w-full h-0.5 bg-current transition-all duration-300 origin-left"></span>
                    <span id="hamburger-middle" class="w-full h-0.5 bg-current transition-all duration-300"></span>
                    <span id="hamburger-bottom" class="w-full h-0.5 bg-current transition-all duration-300 origin-left"></span>
                </div>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-white z-[105] flex flex-col items-center justify-center space-y-8 opacity-0 pointer-events-none transition-all duration-500 translate-y-10">
        {[
            { label: 'Services', href: '/#services' },
            { label: 'Portfolio', href: '/#portfolio' },
            { label: 'About', href: '/#about' },
            { label: 'Process', href: '/#how-it-works' },
            { label: 'FAQ', href: '/#faq' },
            { label: 'Contact Us', href: '/contact' }
        ].map((item) => (
            <a href={item.href} class="mobile-nav-link text-2xl font-bold text-brand-dark uppercase tracking-widest">{item.label}</a>
        ))}
    </div>
</nav>

<script>
    let lastScrollTop = 0;
    const nav = document.getElementById('main-nav');
    const navContainer = document.getElementById('nav-container');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerTop = document.getElementById('hamburger-top');
    const hamburgerMiddle = document.getElementById('hamburger-middle');
    const hamburgerBottom = document.getElementById('hamburger-bottom');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    
    let isMenuOpen = false;

    // Scroll Logic
    const scrollThreshold = 20;

    window.addEventListener('scroll', function() {
        if (isMenuOpen) return;

        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        
        if (scrollTop > scrollThreshold) {
            navContainer?.classList.add('glass-navbar', '!py-4');
            navContainer?.classList.remove('lg:py-8', 'py-6');
        } else {
            navContainer?.classList.remove('glass-navbar', '!py-4');
            navContainer?.classList.add('lg:py-8', 'py-6');
        }

        // Hide navbar when scrolling down, show when scrolling up
        // Only hide if we have scrolled past a certain point (e.g., 100px)
        if (scrollTop > lastScrollTop && scrollTop > 100) {
            if (nav) nav.style.transform = 'translateY(-100%)';
        } else {
            if (nav) nav.style.transform = 'translateY(0)';
        }
        
        lastScrollTop = scrollTop;
    }, { passive: true });

    // Show navbar when mouse is near the top
    window.addEventListener('mousemove', (e) => {
        if (isMenuOpen) return;
        
        // If mouse is within 80px of the top of the viewport
        if (e.clientY < 80) {
            if (nav) nav.style.transform = 'translateY(0)';
        }
    });

    // Mobile Menu Logic
    function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        
        if (isMenuOpen) {
            mobileMenu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
            mobileMenu?.classList.add('opacity-100', 'translate-y-0');
            document.body.style.overflow = 'hidden';
            
            // Hamburger Animation
            hamburgerTop?.classList.add('rotate-[42deg]', 'translate-x-[2px]');
            hamburgerMiddle?.classList.add('opacity-0', 'translate-x-[-10px]');
            hamburgerBottom?.classList.add('-rotate-[42deg]', 'translate-x-[2px]');
        } else {
            mobileMenu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
            mobileMenu?.classList.remove('opacity-100', 'translate-y-0');
            document.body.style.overflow = '';
            
            // Hamburger Animation
            hamburgerTop?.classList.remove('rotate-[42deg]', 'translate-x-[2px]');
            hamburgerMiddle?.classList.remove('opacity-0', 'translate-x-[-10px]');
            hamburgerBottom?.classList.remove('-rotate-[42deg]', 'translate-x-[2px]');
        }
    }

    mobileMenuButton?.addEventListener('click', toggleMenu);

    mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
            if (isMenuOpen) toggleMenu();
        });
    });

    // Active Link Highlighting
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    function highlightNav() {
        let scrollY = window.pageYOffset;
        
        sections.forEach(current => {
            const sectionHeight = (current as HTMLElement).offsetHeight;
            const sectionTop = (current as HTMLElement).offsetTop - 100;
            const sectionId = current.getAttribute('id');
            
            if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
                document.querySelector(`.nav-link[href*=${sectionId}]`)?.classList.add('text-brand-accent');
                document.querySelector(`.nav-link[href*=${sectionId}]`)?.classList.remove('text-brand-muted');
            } else {
                document.querySelector(`.nav-link[href*=${sectionId}]`)?.classList.remove('text-brand-accent');
                document.querySelector(`.nav-link[href*=${sectionId}]`)?.classList.add('text-brand-muted');
            }
        });
    }

    window.addEventListener('scroll', highlightNav);
</script>
