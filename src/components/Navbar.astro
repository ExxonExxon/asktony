---
---
<nav id="main-nav" class="fixed top-0 left-0 w-full z-[100] transition-standard duration-700">
    <div class="glass-navbar px-6 lg:px-20 py-4 lg:py-6 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center space-x-3 group">
            <span class="text-xl lg:text-2xl font-bold tracking-tighter text-brand-dark uppercase">Lorem <span class="text-brand-accent">Ipsum.</span></span>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-10">
            {[
                { label: 'Portfolio', href: '#portfolio' },
                { label: 'About', href: '#about' },
                { label: 'Process', href: '#how-it-works' }
            ].map((item) => (
                <a href={item.href} class="text-[10px] font-bold text-brand-muted hover:text-brand-dark transition-colors uppercase tracking-[0.2em]">{item.label}</a>
            ))}
            <a href="#contact" class="btn-primary !py-3 !px-8">
                Get a Quote
            </a>
        </div>

        <!-- Mobile Button -->
        <div class="md:hidden">
            <button class="text-brand-dark">
                <i class="fas fa-bars text-xl"></i>
            </button>
        </div>
    </div>
</nav>

<script>
    let lastScrollTop = 0;
    const nav = document.getElementById('main-nav');
    const scrollThreshold = 50;

    window.addEventListener('scroll', function() {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        
        if (scrollTop > scrollThreshold) {
            nav?.classList.add('py-2');
        } else {
            nav?.classList.remove('py-2');
        }

        if (scrollTop > lastScrollTop && scrollTop > 200) {
            if (nav) nav.style.transform = 'translateY(-100%)';
        } else {
            if (nav) nav.style.transform = 'translateY(0)';
        }
        
        lastScrollTop = scrollTop;
    }, { passive: true });
</script>
