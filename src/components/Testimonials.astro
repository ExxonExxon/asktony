---
---
<section class="section-padding bg-brand-base">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="max-w-4xl mx-auto text-center space-y-12 reveal-up">
            <div class="space-y-6">
                <h2 class="heading-lg">Ready to Start Your Project?</h2>
                <p class="text-readable max-w-2xl mx-auto">
                    Send a video enquiry for a free quote. We'll review the job and send a detailed quote within 24 hours.
                </p>
                <div class="pt-4">
                    <a href="/quote" class="btn-primary">Get a Free Quote</a>
                </div>
            </div>

            <div class="flex flex-wrap justify-center gap-8 pt-8 border-t border-white/[0.08]">
                <div class="flex items-center gap-3">
                    <i class="fas fa-shield-alt text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">Licensed &amp; Insured</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fas fa-award text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">5-Year Guarantee</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fas fa-calendar-check text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">6 Years Experience</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fas fa-clock text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">Fast Quotes</span>
                </div>
            </div>
        </div>
    </div>
</section>
