<section class="section-padding bg-brand-base">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-16 reveal-up">
                <span class="text-xs font-bold text-brand-accent uppercase tracking-[0.15em]">Testimonials</span>
                <h2 class="heading-lg mt-4">Client Testimonials</h2>
            </div>

            <div class="grid md:grid-cols-2 gap-6 reveal-up">
                <div class="glass-card !p-8 text-left">
                    <div class="flex items-center gap-1 mb-5">
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                    </div>
                    <p class="text-brand-muted leading-relaxed mb-6 text-base">
                        "Anthony did an incredible job with our bathroom renovation. The tiling is flawless and he was professional, punctual and left the space spotless every day. We could not recommend him more highly."
                    </p>
                    <p class="text-sm font-bold text-brand-accent">— Sarah M., Bentleigh</p>
                </div>
                <div class="glass-card !p-8 text-left">
                    <div class="flex items-center gap-1 mb-5">
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                        <i class="fas fa-star text-brand-warning text-sm"></i>
                    </div>
                    <p class="text-brand-muted leading-relaxed mb-6 text-base">
                        "We needed our commercial bathroom floors retiled and Anthony was efficient, clean and delivered a high-quality finish. The whole process was smooth from quote to completion."
                    </p>
                    <p class="text-sm font-bold text-brand-accent">— James P., Moorabbin</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-brand-surface">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="max-w-4xl mx-auto text-center space-y-12 reveal-up">
            <div class="space-y-6">
                <h2 class="heading-lg">Ready to Start Your Tiling Project?</h2>
                <p class="text-readable max-w-2xl mx-auto">
                    Send a video enquiry for a free, obligation-free tiling quote. We will review your Melbourne project and provide a detailed quote within 24 hours.
                </p>
                <div class="pt-4">
                    <a href="/quote" class="btn-primary">Get Your Free Quote</a>
                </div>
            </div>

            <div class="flex flex-wrap justify-center gap-8 pt-8 border-t border-white/[0.08]">
                <div class="flex items-center gap-3">
                    <i class="fas fa-shield-alt text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">Licensed &amp; Insured</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fas fa-award text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">5-Year Guarantee</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fas fa-calendar-check text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">6 Years Experience</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fas fa-clock text-brand-accent pulse-icon"></i>
                    <span class="text-sm font-bold text-brand-dim">Fast Quotes</span>
                </div>
            </div>
        </div>
    </div>
</section>
