---
const steps = [
    { title: "Send a Video Enquiry", desc: "Record the area on any device. Tell us what needs doing and we'll see it before we arrive. No site visit needed for a quote." },
    { title: "We Assess & Quote", desc: "We review the video, calculate materials, and send a detailed quote. Fast and accurate — full visual context, no guesswork." },
    { title: "Installation", desc: "Once approved, we arrive ready. Prep, waterproofing, tiling, finishing — one team, one visit, no surprises." }
];
---
<section id="how-it-works" class="section-padding bg-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="max-w-3xl mb-24 space-y-8 reveal-up">
            <h2 class="heading-lg">Process.</h2>
            <p class="text-readable">Powered by <a href="https://tradsiee.com" target="_blank" rel="noopener" class="font-tradsiee font-bold text-brand-accent hover:text-brand-accent-bright underline underline-offset-2 transition-colors">Tradsiee</a> — send a video, get a fast quote.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
            {steps.map((step, index) => (
                <div class="space-y-8 reveal-up" style={`animation-delay: ${index * 200}ms`}>
                    <div class="flex items-center space-x-4">
                        <span class="text-3xl font-bold text-gray-300">{String(index + 1).padStart(2, '0')}</span>
                        <div class="h-px flex-1 bg-gray-300"></div>
                    </div>
                    <div class="space-y-4">
                        <h3 class="text-xl font-bold text-gray-900 uppercase tracking-tight">{step.title}</h3>
                        <p class="text-base text-gray-700 leading-relaxed">{step.desc}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
