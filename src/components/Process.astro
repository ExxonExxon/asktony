---
const steps = [
    { title: "Send a Video Enquiry", desc: "Record your project on any device — phone, tablet or laptop. Describe what needs doing and we'll see exactly what you're working with before we arrive. No site visit required to get a quote." },
    { title: "We Assess & Quote", desc: "Your enquiry lands in our pipeline with the video attached. We review the work, calculate materials, and send you a detailed quote — fast, accurate, and backed by full visual context." },
    { title: "Expert Installation", desc: "Once approved, we arrive with everything prepared. From structural preparation and waterproofing to precision tiling and professional finishing — one team, one visit, no surprises." }
];
---
<section id="how-it-works" class="section-padding bg-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-20">
        <div class="max-w-3xl mb-24 space-y-8 reveal-up">
            <h2 class="heading-lg">Process.</h2>
            <p class="text-readable">Powered by <a href="https://tradsiee.com" target="_blank" rel="noopener" class="font-tradsiee font-bold text-brand-accent hover:text-brand-accent-bright underline underline-offset-2 transition-colors">Tradsiee</a> — video leads that let us assess and quote your project before we step foot on site.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
            {steps.map((step, index) => (
                <div class="space-y-8 reveal-up" style={`animation-delay: ${index * 200}ms`}>
                    <div class="flex items-center space-x-4">
                        <span class="text-3xl font-bold text-gray-300">{String(index + 1).padStart(2, '0')}</span>
                        <div class="h-px flex-1 bg-gray-300"></div>
                    </div>
                    <div class="space-y-4">
                        <h3 class="text-xl font-bold text-gray-900 uppercase tracking-tight">{step.title}</h3>
                        <p class="text-base text-gray-700 leading-relaxed">{step.desc}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
