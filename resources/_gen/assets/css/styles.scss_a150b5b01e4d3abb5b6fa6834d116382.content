@font-face {
  font-family: ubuntu-regular;
  src: url(../fonts/Ubuntu-Regular.ttf); }
@font-face {
  font-family: ubuntu-medium;
  src: url(../fonts/Ubuntu-Medium.ttf); }
@font-face {
  font-family: ubuntu-light;
  src: url(../fonts/Ubuntu-Light.ttf); }
@font-face {
  font-family: ubuntu-bold;
  src: url(../fonts/Ubuntu-Bold.ttf); }
/* Giving custom font-family to whole page */
body {
  font-family: ubuntu-light;
  overflow-x: hidden; }
/* Giving particular size to Menubar  Buttons */
nav {
  font-family: ubuntu-regular;
  font-size: 18px; }
/* Giving Bottom green border in Menu bar selected items */
.border-b-4 {
  border-bottom: 4px solid #93ED5E; }
/* RESPONSIVE NAVBAR STARTING FROM HERE */
@media (max-width: 767px) {
  .navicon {
    width: 1.125em;
    height: 0.125em; }
  .navicon::before,
  .navicon::after {
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    transition: all .2s ease-out;
    content: '';
    background: #3D4852; }
  .navicon::before {
    top: 5px; }
  .navicon::after {
    top: -5px; }
  .menu-btn:not(:checked) ~ .menu {
    display: none; }
  .menu-btn:checked ~ .menu {
    display: block; }
  .menu-btn:checked ~ .menu-icon .navicon {
    background: transparent; }
  .menu-btn:checked ~ .menu-icon .navicon::before {
    transform: rotate(-45deg); }
  .menu-btn:checked ~ .menu-icon .navicon::after {
    transform: rotate(45deg); }
  .menu-btn:checked ~ .menu-icon .navicon::before,
  .menu-btn:checked ~ .menu-icon .navicon::after {
    top: 0; } }
/* RESPONSIVE NAVBAR ENDING HERE */
/* After Navbar  TOP Banner Heading */
.header-banner-heading {
  font-family: ubuntu-bold;
  font-weight: 700;
  font-size: 3em;
  line-height: 50px;
  margin-left: 10%; }
@media (min-width: 1400px) {
  .header-banner-heading {
    font-family: ubuntu-bold;
    font-weight: 700;
    font-size: 4em;
    line-height: 80px;
    margin-left: 10%; } }
@media (min-width: 1600px) {
  .header-banner-heading {
    font-family: ubuntu-bold;
    font-weight: 700;
    font-size: 5em;
    line-height: 80px;
    margin-left: 10%; } }
/* LOGO MOVING RIGHT */
@media (min-width: 800px) {
  .logo-img {
    margin-left: 80px; } }
/* TOP BANNER Bbackground IMAGE */
.bg-top-banner {
  height: 35rem;
  background-image: url("images/header.jpg");
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover; }
@media (max-width: 650px) {
  .bg-top-banner {
    height: 35rem;
    background-image: url("images/header_mobile.jpg");
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover; } }
.header-banner-heading-border {
  border-bottom: 5px solid #93ED5E; }
/* Hiding the Banner heading at mobile view */
@media (max-width: 600px) {
  .header-banner-heading {
    display: none; }
  .bg-top-banner {
    background-position: center; } }
/* JUST ASK TONY SECTION */
.just-ask-tony {
  position: relative;
  height: -moz-fit-content;
  height: fit-content;
  width: 80%; }
.just-ask-tony-heading {
  position: relative;
  font-family: ubuntu-bold;
  font-weight: 700;
  font-size: 50px;
  color: #193674;
  margin-top: 20px; }
.just-ask-tony-pargraph {
  margin-top: 20px; }
.just-ask-tony-pargraph p {
  font-family: ubuntu-regular;
  text-align: justify;
  font-size: 18px; }
/* ABOUT US SECTION STARTS FROM HERE */
.about-us-section {
  width: 80%; }
.bg-about-us {
  height: 70vh;
  background-image: url("images/tony.jpg");
  background-size: cover; }
@media (max-width: 768px) {
  .bg-about-us {
    height: 70vh;
    background-image: url("images/tony_mobile.jpg");
    background-size: cover;
    background-position: right; } }
.about-us-heading {
  position: relative;
  font-family: ubuntu-bold;
  font-weight: 700;
  font-size: 50px;
  color: #193674;
  margin: 20px 0;
  margin-bottom: 25px; }
.about-us-paraghaph {
  font-family: ubuntu-regular;
  text-align: justify;
  font-size: 18px; }
/* ABOUT US SECTION ENDS HERE */
/* Footer Section  start from here */
.footer-section {
  background-color: #193674;
  height: 60vh;
  position: relative;
  margin-top: 100px; }
.contact-us-div {
  width: 100%;
  padding-top: 50px; }
.contact-us-heading {
  position: relative;
  font-family: ubuntu-bold;
  font-weight: 700;
  font-size: 50px;
  color: #FFF;
  margin: 20px 0;
  text-align: center; }
.contact-us-list {
  color: white; }
@media (max-width: 1100px) {
  .contact-us-div {
    width: 100%;
    padding-top: 50px;
    padding-left: 50px; }
  .contact-us-heading {
    position: relative;
    font-family: ubuntu-bold;
    font-weight: 700;
    font-size: 50px;
    color: #FFF;
    margin: 20px 0;
    text-align: left; }
  .contact-us-list {
    color: white;
    text-align: left; } }
.contact-ul, .contact-ul li, .contact-ul i {
  font-size: 22px;
  list-style: none; }
.mobile {
  padding-left: 185px; }
@media (max-width: 1100px) {
  .mobile {
    padding-left: 1px; } }
.copyright {
  font-size: 20px;
  color: white;
  position: absolute;
  right: 50px;
  bottom: 10px; }
.curved-element {
  background-color: #93ED5E;
  height: 180px;
  width: 450px;
  position: absolute;
  right: 0;
  top: -50px;
  -webkit-border-top-left-radius: 247px;
  -webkit-border-bottom-left-radius: 247px;
  -moz-border-radius-topleft: 247px;
  -moz-border-radius-bottomleft: 247px;
  border-top-left-radius: 247px;
  border-bottom-left-radius: 247px; }
.curved-element-for-mobile {
  background-color: #93ED5E;
  height: 15vh;
  width: 100%;
  position: absolute;
  bottom: 0;
  display: none; }
@media (max-width: 768px) {
  .contact-us-div {
    width: 100%;
    padding-top: 10px;
    text-align: left; }
  .contact-us-heading {
    position: relative;
    font-family: ubuntu-bold;
    font-weight: 700;
    font-size: 50px;
    color: #FFF;
    margin: 20px 0;
    text-align: left; }
  .contact-us-list {
    color: white;
    text-align: justify; }
  .contact-ul, .contact-ul li, .contact-ul i {
    font-size: 18px;
    text-align: left;
    margin-left: -5px;
    list-style: none; }
  .contact-ul i {
    padding-right: 5px; }
  .mobile {
    padding-left: 0px; }
  .copyright {
    font-size: 20px;
    color: white;
    text-align: left;
    margin: 10px auto;
    padding-bottom: 20px; }
  .curved-element {
    background-color: #93ED5E;
    height: 120px;
    width: 300px; }
  .movie-phone-image {
    position: absolute;
    left: 40px;
    top: 8px !important; }
  .movie-paragraph {
    font-size: 13px !important;
    position: absolute;
    top: 25px;
    right: 5px; } }
@media (max-width: 600px) {
  .curved-element {
    display: none; }
  .curved-element-for-mobile {
    display: block; } }
.inner-movie {
  position: relative; }
.movie-phone-image {
  position: absolute;
  left: 40px;
  top: 40px; }
.movie-paragraph {
  font-size: 20px;
  font-family: ubuntu-regular;
  position: absolute;
  top: 25px;
  right: 5px; }
@media (max-width: 992px) {
  .copyright {
    font-size: 20px;
    color: white;
    position: relative;
    text-align: right;
    margin-top: 20px; } }
.special-div-for-footer {
  position: relative; }
.movie-phone-image {
  position: absolute;
  left: 20px;
  text-align: center;
  bottom: 5px; }
.movie-paragraph-for-mobile {
  position: absolute;
  right: 20px;
  font-family: 16px;
  text-align: center; }
@media (min-width: 768px) {
  .contact-us-heading {
    position: absolute;
    font-family: ubuntu-bold;
    font-weight: 700;
    font-size: 50px;
    color: #FFF;
    left: 0;
    margin: 20px 0;
    text-align: justify;
    text-align: center; }
  .contact-us-list {
    color: white;
    text-align: justify; }
  .contact-ul, .contact-ul i {
    font-size: 20px;
    text-align: justify;
    margin-left: 10px;
    list-style: none; }
  .contact-ul i {
    padding-right: 5px; }
  .mobile {
    padding-left: 0px; }
  .copyright {
    font-size: 20px;
    color: white;
    text-align: center;
    margin: 10px auto;
    padding-bottom: 20px; }
  .curved-element {
    display: block; }
  .curved-element-for-mobile {
    display: none; }
  .contact-us-div {
    margin-left: 100px; } }
/* HOW iT WORKS */
.how-it-woks-section {
  width: 80%; }
@media (max-width: 800px) {
  .how-it-woks-section {
    width: 100%; } }
.how-heading {
  color: #193674;
  font-family: ubuntu-bold;
  font-weight: 600;
  font-size: 25px;
  margin-left: 5px;
  margin-top: -10px; }
.how-paragraph {
  margin: 15px 30px;
  font-family: ubuntu-regular;
  font-size: 18px;
  color: black;
  text-align: justify; }
/* SERVICES starts from here */
.secvices-container {
  width: 80%; }
.services-button {
  width: 55%;
  padding: 20px 0;
  margin: 0 auto;
  z-index: -1;
  background-color: #193674;
  color: white;
  margin-top: -50px;
  padding-bottom: -10px;
  padding-top: 20px;
  font-size: 25px;
  font-weight: bold; }
@media (max-width: 600px) {
  .services-button {
    width: 70%; }
  .secvices-container {
    width: 95%; } }
.max-h-0 {
  max-height: 0; }
.services-button-for-mobile {
  width: 100%;
  padding: 20px 0;
  margin: 0 auto;
  z-index: -1;
  background-color: #193674;
  color: white;
  margin-top: -5px;
  font-size: 25px;
  font-weight: bold; }
.accordion {
  width: 100%;
  padding: 20px 0;
  margin: 0 auto;
  z-index: -1;
  background-color: #193674;
  color: white;
  margin-top: -5px;
  font-size: 25px;
  font-weight: bold;
  transition: 0.4s; }
.accordion i {
  margin-left: 50px; }
.active, .accordion:hover > .accordion i {
  background-color: #0b265f; }
.active .accordion i {
  color: blue; }
.panel {
  padding: 0 18px;
  display: none;
  background-color: white;
  overflow: hidden; }
.accordion:after > .accordion i {
  font-weight: bold;
  float: right; }
@media (min-width: 768px) {
  .tablet-display {
    display: block; }
  .mobile-display {
    display: none; } }
@media (max-width: 768px) {
  .tablet-display {
    display: none; }
  .mobile-display {
    display: block; } }
